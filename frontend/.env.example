# Maps JavaScript API (browser). Copy to frontend/.env.local — never commit the real key.
# Restrict this key to HTTP referrers: http://localhost:5173/* and
# https://YOUR-VERCEL-DOMAIN/*  (include the trailing /*). Enable Maps JavaScript API
# and billing. This is a different restriction than the server Geocoding key.
VITE_GOOGLE_MAPS_API_KEY=

# Production only — Render API origin, no trailing slash. Leave unset in Vite dev
# so `/api` stays on the local proxy. Example: https://skyeye-api.onrender.com
VITE_API_BASE_URL=
