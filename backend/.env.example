# Copy to backend/.env and adjust locally.
# Detection phase needs no secrets. Maps/LLM keys go in .env only — never commit them.

# Flask dev server (5000 collides with macOS AirPlay Receiver)
FLASK_PORT=5001

# Single allowed browser origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Detection model
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=cpu
CONF_THRESHOLD=0.25

# Tiling for large drone-altitude images
TILE_SIZE=640
TILE_OVERLAP=0.2

# Request / image guards
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=40000000

# Phase 3 — Google Maps Geocoding API (server-side). Never commit the real key.
# Enable the Geocoding API on the same Google Cloud project as the Maps JS key.
GOOGLE_MAPS_API_KEY=
