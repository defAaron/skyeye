# Copy to backend/.env and adjust locally.
# Detection phase needs no secrets. Maps/LLM keys go in .env only — never commit them.

# Flask dev server (5000 collides with macOS AirPlay Receiver)
FLASK_PORT=5001

# Allowed browser origins, comma-separated. Dev default is the Vite server.
# Production: set to the Vercel origin, e.g. https://skyeye.vercel.app
CORS_ORIGIN=http://localhost:5173
# Optional regex for extra origins (e.g. Vercel preview URLs). Leave empty locally.
CORS_ORIGIN_REGEX=
# Set to 1 on Render so per-IP limits use the client hop behind the load balancer.
# Leave unset on a laptop — X-Forwarded-For is otherwise ignored.
TRUST_PROXY=

# Detection model
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=cpu
CONF_THRESHOLD=0.25

# Tiling for large drone-altitude images
TILE_SIZE=640
TILE_OVERLAP=0.2
# 1 keeps RSS down on Render. Raise to 4–8 on a laptop with spare RAM.
TILE_BATCH_SIZE=1
TORCH_NUM_THREADS=1

# Request / image guards
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=40000000

# Phase 3 — Google Maps Geocoding API (server-side). Never commit the real key.
# Enable the Geocoding API on the same Google Cloud project as the Maps JS key.
GOOGLE_MAPS_API_KEY=

# Phase 4 — LLM intake (server-side). Never commit the real keys.
# Gemini: https://aistudio.google.com/apikey  (Google AI Studio, not the Maps key)
# Models tried in order: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.5-flash,
# gemini-3.1-flash-lite, gemini-flash-latest
# Groq fallback: https://console.groq.com/keys  (openai/gpt-oss-20b, then 120b)
GEMINI_API_KEY=
GROQ_API_KEY=

# Rate limits — keep Gemini under typical free-tier RPM/RPD so a tight loop
# cannot burn the key. 0 disables that window (not recommended).
GEMINI_MAX_RPM=8
GEMINI_MAX_RPD=200
GEMINI_COOLDOWN_SECONDS=60
GROQ_MAX_RPM=20
GROQ_MAX_RPD=500
GROQ_COOLDOWN_SECONDS=30
GEOCODE_MAX_RPM=20
GEOCODE_MAX_RPD=400
GEOCODE_COOLDOWN_SECONDS=60
EXTRACT_IP_PER_MINUTE=8
EXTRACT_IP_PER_DAY=20
GEOCODE_IP_PER_MINUTE=10
GEOCODE_IP_PER_DAY=80
DETECT_IP_PER_MINUTE=20
DETECT_IP_PER_DAY=80
